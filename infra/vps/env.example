# =============================================================================
# XovenMart — API production env (template)
# =============================================================================
# This file is a TEMPLATE only. The real file lives on the VPS at
# /var/www/xovenmart/api/shared/.env and is created by bootstrap.sh.
# NEVER commit the real .env with secrets.
#
# Lines beginning with `# REPLACE` MUST be edited before the first deploy.
# Lines beginning with `# OK to leave` are reasonable defaults.
# =============================================================================

# OK to leave
NODE_ENV=production
PORT=3001
API_PREFIX=api/v1

# OK to leave (bootstrap.sh generates the password and inserts it here)
DATABASE_URL=postgresql://xovenmart_app:CHANGEME@127.0.0.1:5432/xovenmart

# OK to leave (these match the domains the bootstrap configures)
PUBLIC_SITE_URL=https://app.xovenmart.com
PUBLIC_API_URL=https://api.xovenmart.com

# REPLACE with your real frontend origins (CSV). At minimum:
# https://app.xovenmart.com (the public storefront)
# https://admin.xovenmart.com (the admin panel — same Next.js bundle, /admin routes)
CORS_ORIGIN=https://app.xovenmart.com,https://www.xovenmart.com,https://admin.xovenmart.com

# OK to leave (bootstrap.sh generates random secrets on first run)
JWT_SECRET=CHANGEME_48_BYTES_BASE64
JWT_REFRESH_SECRET=CHANGEME_OTHER_48_BYTES_BASE64
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# REPLACE — get from https://www.bulksmsbd.com/
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
BULKSMSBD_BASE_URL=https://api.bulksmsbd.com/api/v1/

# REPLACE — merchant numbers for cash-on-delivery fallback display
BKASH_MERCHANT_NUMBER=
BKASH_MERCHANT_NAME=
NAGAD_MERCHANT_NUMBER=

# REPLACE — Cloudflare R2 bucket credentials (for product image uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=xovenmart-media
R2_PUBLIC_URL=https://cdn.xovenmart.com

# REPLACE — Firebase Cloud Messaging (admin push notifications)
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# REPLACE — at least one email provider required for transactional email
BREVO_API_KEY=
RESEND_API_KEY=

# OK to leave
OTP_HIDE_DEV_CODE=

# OPTIONAL — error tracking
SENTRY_DSN=
