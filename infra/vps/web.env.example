# =============================================================================
# XovenMart — Web (Next.js) production env (template)
# =============================================================================
# Real file lives at /var/www/xovenmart/web/shared/.env.production on the VPS.
#
# IMPORTANT: NEXT_PUBLIC_* values are baked into the Next.js bundle at
# BUILD time. Changing them after deploy requires a rebuild + restart of
# xovenmart-web (NOT just an env file edit).
# =============================================================================

# BAKED AT BUILD TIME — what the browser fetches API calls from.
NEXT_PUBLIC_API_URL=https://api.xovenmart.com

# OK to leave — OSM tile server. If you self-host tiles, point at your CDN.
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# OPTIONAL — Umami analytics (privacy-friendly, no cookies)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
UMAMI_URL=