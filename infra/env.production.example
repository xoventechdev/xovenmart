# ============================================================================
# XovenMart — Production .env for docker-compose (BDIX VPS, 103.72.65.188)
# ============================================================================
# This file is consumed by infra/docker-compose.yml as a `.env` file via
# `docker compose --env-file`. Each variable below corresponds to a
# `${VAR}` reference in docker-compose.yml. The bdix-bootstrap.sh copies
# this file to infra/.env and injects real secrets via sed.
#
# DO NOT commit real production secrets to git. This file is a TEMPLATE ONLY.
# ============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=production
PUBLIC_SITE_URL=https://xovenmart.com
PUBLIC_API_URL=http://api:3001

# --- Database (in-stack Postgres 18) ---------------------------------------
# Built by the bootstrap script from POSTGRES_PASSWORD (same value as below):
#   postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
POSTGRES_USER=xovenmart
POSTGRES_PASSWORD=__REPLACE_ME__
POSTGRES_DB=xovenmart
DATABASE_URL=postgresql://xovenmart:__REPLACE_ME__@postgres:5432/xovenmart

# --- Auth (JWT) -------------------------------------------------------------
# Generate a 48-byte secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=__REPLACE_ME__
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- SMS (BulkSMS BD) -------------------------------------------------------
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=XovenMart

# --- Payments (manual reconciliation Day 1) -------------------------------
BKASH_MERCHANT_NUMBER=
NAGAD_MERCHANT_NUMBER=

# --- Maps (free OSM tiles) -------------------------------------------------
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Analytics (Umami) -----------------------------------------------------
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- FCM (push notifications) ---------------------------------------------
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# --- Backup integration ----------------------------------------------------
BACKUP_WEBHOOK_TOKEN=__REPLACE_ME__
BACKUP_NOTIFY_EMAILS=

# --- Secrets-at-rest (32-byte base64; required for admin AI/email modules) -
# Same key is also referenced as LLM_ENCRYPTION_KEY in the api service.
SMTP_ENCRYPTION_KEY=__REPLACE_ME__
