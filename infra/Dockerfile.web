# Multi-stage build for Next.js Web
FROM node:20-alpine AS builder
# Mark every shell we run as a Next.js production-build phase so
# `process.env.NEXT_PHASE === "phase-production-build"` evaluates true
# inside useQuery / apiServer queryFn bodies. Next 15's static-export
# validation pass renders every dynamic page once during `next build` —
# without an api container reachable at localhost:3001, unguarded
# `fetch()` calls would hang 60s on connect-refused and abort the
# build. Our hooks short-circuit when they see this env var; we set
# it explicitly here as a belt-and-braces guarantee.
ENV NEXT_PHASE=phase-production-build
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9 --activate

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY packages/db/package.json ./packages/db/
COPY apps/web/package.json ./apps/web/

RUN pnpm install --frozen-lockfile

COPY packages/db ./packages/db
COPY apps/web ./apps/web

RUN pnpm --filter @xovenmart/db generate
RUN pnpm --filter @xovenmart/web build

# ---- Production image ----
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

RUN corepack enable && corepack prepare pnpm@9 --activate

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/db/package.json ./packages/db/
COPY --from=builder /app/packages/db/node_modules ./packages/db/node_modules
COPY --from=builder /app/packages/db/prisma ./packages/db/prisma
COPY --from=builder /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=builder /app/apps/web/package.json ./apps/web/
COPY --from=builder /app/apps/web/.next ./apps/web/.next
COPY --from=builder /app/apps/web/public ./apps/web/public

WORKDIR /app/apps/web

EXPOSE 3000

# Healthcheck hits `/api/health` — a route handled by
# `apps/web/app/api/health/route.ts`. We use a generous start-period
# (45s) because Next.js boot + first-request compile can take that
# long under cold-cache conditions, and `--tries=1` because the
# docker HEALTHCHECK already retries on its own with `--retries=5`.
# Without this healthcheck passing, Traefik (the coolify-proxy on
# 169.58.46.162) marks the service unhealthy and serves its standard
# `no available server` 503 page on `https://app.xovenmart.com/`.
HEALTHCHECK --interval=30s --timeout=8s --start-period=45s --retries=5 \
  CMD wget -q --tries=1 --spider http://localhost:3000/api/health || exit 1

CMD ["pnpm", "start"]
