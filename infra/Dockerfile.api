# Multi-stage build for NestJS API
# Both stages use node:20-bookworm-slim (Debian-based, glibc). The
# original alpine-musl setup hit "Error loading shared library
# libssl.so.1.1" because Prisma 5.22 ships a musl binary but
# Alpine 3.20+ ships libssl 3.x with no 1.1 backport. Debian's
# libssl3 is forward-compatible — the glibc Prisma binary from
# `prisma generate` works without any compat shim.
FROM node:20-bookworm-slim AS builder
WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@9 --activate

# Copy workspace files
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY packages/db/package.json ./packages/db/
COPY apps/api/package.json ./apps/api/

RUN pnpm install --frozen-lockfile

# Copy source
COPY packages/db ./packages/db
COPY apps/api ./apps/api

# Generate Prisma client + build API
RUN pnpm --filter @xovenmart/db generate
RUN pnpm --filter @xovenmart/api build

# Prune dev deps
RUN pnpm prune --prod

# ---- Production image ----
# Use node:20-bookworm-slim (Debian-based) instead of alpine because
# Prisma 5.22 ships a musl-linked query engine that needs libssl 1.1,
# and Alpine 3.20+ ships libssl 3.x with no 1.1 backport. The musl
# engine binary is what `prisma generate` produces for the native
# target — switching to glibc via Debian gives us a clean libssl3
# match without needing to repin Prisma's binary target.
FROM node:20-bookworm-slim AS runner
WORKDIR /app

ENV NODE_ENV=production

# Prisma 5.22 ships a `libquery_engine-debian-openssl-1.1.x.so.node`
# binary (its default glibc target still points at openssl 1.1).
# Debian 12 (bookworm) ships only libssl3, so the engine can't dlopen
# the shared lib and the API container crash-loops with
# "Error loading shared library libssl.so.1.1: No such file or
# directory". Install the libssl1.1 compat package from the bookworm
# repo — it's still published in Debian's pool for legacy consumers.
# `libssl1.1` is a virtual package provided by `openssl1.1` on this
# base image; `--allow-downgrades` + explicit `openssl1.1` ensures
# apt doesn't try to pull in libssl3 and conflict.
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl1.1 postgresql-client \
 && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@9 --activate

# Copy built artifacts
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/db ./packages/db
COPY --from=builder /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder /app/apps/api/package.json ./apps/api/
COPY --from=builder /app/apps/api/dist ./apps/api/dist

# Generate final Prisma client
RUN pnpm --filter @xovenmart/db generate

WORKDIR /app/apps/api

EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://localhost:3001/api/v1/health || exit 1

CMD ["node", "dist/main.js"]
