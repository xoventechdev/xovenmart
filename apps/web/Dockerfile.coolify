# =============================================================================
# XovenMart Web (Next.js + Admin) — Dockerfile for Coolify
#
# Build context = monorepo root.
# Build path    = apps/web/Dockerfile.coolify
# =============================================================================

FROM node:22-bookworm-slim AS builder

RUN corepack enable \
 && corepack prepare pnpm@9.0.0 --activate

# Install required system libs (Prisma needs OpenSSL)
RUN apt-get update -qq \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Override Coolify's default NODE_ENV=production here so devDependencies
# (which include the `prisma` CLI and `sharp`) are installed.
ENV NODE_ENV=development

WORKDIR /repo

# Workspace manifests + lockfile → cache install.
# We only need web + db; the API image isn't relevant here.
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* .npmrc* ./
COPY apps/web/package.json     ./apps/web/
COPY packages/db/package.json  ./packages/db/

RUN pnpm install --frozen-lockfile \
    --filter @xovenmart/web... \
    --filter @xovenmart/db

COPY packages/db   ./packages/db/
COPY apps/web      ./apps/web/

# Create build-time /repo/.env so packages/db/scripts/sync-env.js runs.
# Values are placeholders — Prisma generate doesn't connect.
RUN printf 'DATABASE_URL=postgresql://xovenmart:xovenmart_dev_pass@172.17.0.1:5432/xovenmart\nSMTP_ENCRYPTION_KEY=1kqYkFvmeZbHfzWvQDmNa6gKVBpl8Rl8o52P3EyzSeU=\n' > /repo/.env

# Generate Prisma client (web app references @xovenmart/db for the enum types)
RUN pnpm --filter @xovenmart/db exec prisma generate

# Build the web bundle (admin panel lives inside this app at /admin).
# NEXT_PUBLIC_API_URL must be set at build time because it gets baked into
# the client bundle.
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

# CRITICAL: switch NODE_ENV back to production before running `next build`.
# We set NODE_ENV=development earlier in this stage so that `pnpm install`
# would fetch devDependencies (prisma CLI, etc.). But Next.js 15, when run
# in a non-production NODE_ENV, tries to statically generate the legacy
# Pages-Router /404 and /500 fallback pages — those import `<Html>` from
# `next/document`, which is only valid inside `pages/_document.tsx` (we use
# the App Router and have no such file, so the build aborts with
# "Error: <Html> should not be imported outside of pages/_document").
# Setting NODE_ENV=production disables that legacy fallback generation.
ENV NODE_ENV=production
RUN pnpm --filter @xovenmart/web build


# ---- Stage 2: runtime ----
FROM node:22-bookworm-slim AS runner

ENV NODE_ENV=production

RUN apt-get update -qq \
 && apt-get install -y --no-install-recommends openssl ca-certificates wget \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /repo

COPY --from=builder /repo/package.json /repo/pnpm-workspace.yaml ./
COPY --from=builder /repo/pnpm-lock.yaml* ./
COPY --from=builder /repo/.env ./.env
COPY --from=builder /repo/packages/db   ./packages/db/
COPY --from=builder /repo/apps/web      ./apps/web/
COPY --from=builder /repo/apps/web/.next ./apps/web/.next
COPY --from=builder /repo/apps/web/public ./apps/web/public

RUN corepack enable \
 && corepack prepare pnpm@9.0.0 --activate \
 && pnpm install --prod --frozen-lockfile --filter @xovenmart/web... \
 && pnpm install --prod --frozen-lockfile --filter @xovenmart/db \
 && (pnpm --filter @xovenmart/db exec prisma generate || echo "prisma generate skipped — using cached client") \
 && rm -rf /root/.cache /tmp/pnpm-* /root/.local/share/pnpm \
 && ls -la apps/web/.next/ | head

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=8s --start-period=20s --retries=3 \
  CMD wget --spider --no-verbose -q http://127.0.0.1:3000/ \
   || exit 1

WORKDIR /repo/apps/web

CMD ["sh", "-c", "echo \"NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL\" && exec pnpm start"]
