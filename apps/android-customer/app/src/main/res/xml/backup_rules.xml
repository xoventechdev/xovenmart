<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto-backup rules — keep tokens OUT of cloud backups. EncryptedSharedPrefs
  holds access + refresh tokens; we exclude it explicitly.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="xm_auth_tokens.xml" />
    <exclude domain="sharedpref" path="xovenmart_secure_prefs.xml" />
</full-backup-content>
