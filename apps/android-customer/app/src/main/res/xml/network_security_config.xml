<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security config for the Android Customer app.

  Debug: cleartext allowed to the emulator host (`10.0.2.2`) so the same APK
         can talk to a NestJS API running on the developer's machine. Also
         allows plain HTTP to any LAN address — convenient for physical
         devices pointing at a dev backend.

  Release: cleartext blocked globally. The release build sets
           `usesCleartextTraffic="false"` indirectly via the base config
           (`<base-config cleartextTrafficPermitted="false" />`).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Debug-only exception: allow cleartext to the emulator host + LAN IPs. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <!-- LAN ranges (192.168.x.x, 10.x.x.x, 172.16-31.x.x) — wildcards aren't
             permitted in domain elements, so we list the actual host parts the
             device will talk to. Most teams just point at a specific dev IP. -->
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">192.168.1.0</domain>
    </domain-config>
</network-security-config>
