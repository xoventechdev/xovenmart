# ============================================================================
# XovenMart — Production Environment Variables (TEMPLATE)
# Paste these into cPanel -> Setup Node.js App -> Environment variables.
# Replace all `CHANGE_ME_*` values with real secrets BEFORE pasting.
#
# DO NOT commit real production secrets to git. This file is a TEMPLATE ONLY.
# ============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=production
PORT=3001
API_PREFIX=api/v1
PUBLIC_SITE_URL=https://xovenmart.com
PUBLIC_API_URL=https://api.xovenmart.com

# --- Database (cPanel Postgres) ---------------------------------------------
# Format: postgresql://<cpaneluser>_<dbuser>:<PASSWORD>@localhost:5432/<cpaneluser>_<dbname>
# From your phpPgAdmin:
#   Server:    PostgreSQL on /var/run/postgresql:5432
#   User:      xovendns_xovenmart_app  (cPanel prefixes with the account)
#   Database:  xovendns_xovenmart_app
DATABASE_URL=postgresql://xovendns_xovenmart_app:CHANGE_ME_DB_PASSWORD@localhost:5432/xovendns_xovenmart_app

# --- Auth (JWT) -------------------------------------------------------------
# Generate two distinct 48-byte secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CHANGE_ME_JWT_SECRET_48_BYTES_BASE64
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET_48_BYTES_BASE64

# --- SMS (BulkSMSBD) --------------------------------------------------------
# Sign up at https://www.bulksmsbd.com/ — leave blank to disable SMS sends
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=XovenMart
BULKSMSBD_BASE_URL=https://api.bulksmsbd.com/api/v1/send

# --- Payments (manual reconciliation Day 1) ---------------------------------
BKASH_MERCHANT_NUMBER=01XXXXXXXXX
BKASH_MERCHANT_NAME=XovenMart
NAGAD_MERCHANT_NUMBER=01XXXXXXXXX

# --- Maps (free OSM tiles, no API key needed) --------------------------------
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Image storage (Cloudflare R2) -----------------------------------------
# Leave blank to use local disk storage (./public/uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=xovenmart-images
R2_PUBLIC_URL=https://cdn.xovenmart.com

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed origins for the browser web app
CORS_ORIGIN=https://xovenmart.com,https://www.xovenmart.com,https://admin.xovenmart.com

# --- FCM (push notifications) -----------------------------------------------
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# --- Analytics (Umami) ------------------------------------------------------
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
UMAMI_URL=https://xovenmart.com

# --- Sentry (optional error tracking) ---------------------------------------
SENTRY_DSN=