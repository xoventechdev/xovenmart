# ============================================================
# XovenMart — Environment Variables (development template)
# Copy to .env and fill in real values
# ============================================================

# ---------- Core ----------
NODE_ENV=production
PUBLIC_SITE_URL=https://xovenmart.com
PUBLIC_API_URL=https://api.xovenmart.com

# ---------- Database (Postgres) ----------
# Local dev: postgres://xovenmart:xovenmart@localhost:5432/xovenmart
DATABASE_URL=postgresql://xovenmart:CHANGE_ME_POSTGRES_PASSWORD@127.0.0.1:5432/xovenmart
# The bootstrap scripts sed-replace POSTGRES_PASSWORD below. docker-compose.yml
# reads POSTGRES_PASSWORD as ${POSTGRES_PASSWORD}, NOT from DATABASE_URL, so
# this separate var is required (don't remove it).
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_USER=xovenmart
POSTGRES_DB=xovenmart

# ---------- Auth ----------
# Generate: openssl rand -base64 48
# IMPORTANT: BOTH secrets must be set. jwt-auth.ts uses JWT_SECRET for access
# tokens and JWT_REFRESH_SECRET for refresh tokens — losing either forces
# every customer to re-login.
JWT_SECRET=replace-me-with-a-long-random-secret-min-48-chars
JWT_REFRESH_SECRET=replace-me-with-a-long-random-secret-min-48-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ---------- SMS (BulkSMSBD) ----------
# Sign up at https://www.bulksmsbd.com/
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=XovenMart
BULKSMSBD_BASE_URL=https://api.bulksmsbd.com/api/v1/send

# ---------- Payments ----------
# bKash Merchant Payment Link (manual reconciliation Day 1)
BKASH_MERCHANT_NUMBER=01XXXXXXXXX
BKASH_MERCHANT_NAME=XovenMart
# Nagad Merchant QR (printed on rider bag)
NAGAD_MERCHANT_NUMBER=01XXXXXXXXX

# ---------- Maps ----------
# OSM tile server (default free tile.openstreetmap.org)
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ---------- Image storage ----------
# Local dev: ./public/uploads
# Prod: served via Caddy from /uploads (see infra/Caddyfile). The api
# writes product images + brand assets to /repo/apps/api/uploads, which
# is mounted as a named volume (api_uploads) shared with Caddy.
#
# (R2 was previously used for product images; it's now only a candidate
# for future CDN-fronting. Keep the variables blank for now.)

# ---------- FCM (push notifications) ----------
# Get from Firebase Console → Project Settings → Service Accounts
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# ---------- Analytics (Umami) ----------
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
UMAMI_URL=https://xovenmart.com

# ---------- Sentry (optional, error tracking) ----------
SENTRY_DSN=

# ---------- SMTP (admin-managed email providers) ----------
# 32-byte AES-256-GCM key for encrypting SMTP passwords at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SMTP_ENCRYPTION_KEY=

# SMTP — dev fallback (only used when no DB provider is configured AND NODE_ENV != production)
SMTP_DEV_HOST=
SMTP_DEV_PORT=587
SMTP_DEV_USER=
SMTP_DEV_PASS=
SMTP_DEV_FROM_ADDRESS=dev@xovenmart.local
SMTP_DEV_FROM_NAME=XovenMart Dev

# Backup notification recipients — comma-separated. Leave blank to disable.
# Used by BackupService.notifyBackupFinished() after every backup (success + failure).
BACKUP_NOTIFY_EMAILS=

# ---------- Backups ----------
# Local-only backup: the `backup` container dumps Postgres to a shared
# `backups` named volume and tars the api uploads alongside, then POSTs
# the api webhook so the dump appears in the admin UI and is emailed
# to BACKUP_NOTIFY_EMAILS.
#
# BACKUP_DIR must match the path the api mounts. The api reads this
# env to walk the directory when the webhook fires.
BACKUP_DIR=/var/lib/xovenmart/backups
# Shared secret used by infra/backup.sh to POST the api webhook
# (POST /admin/system/backups/scan/webhook). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_WEBHOOK_TOKEN=replace-with-a-long-random-secret-for-the-bash-script-webhook
# Optional: override the api URL the backup container curls (default
# is http://api:3001 inside the compose network).
BACKUP_API_URL=
# Days of daily backups to keep on disk. Older day-directories are
# pruned automatically.
BACKUP_KEEP_DAYS=14

# ---------- CORS ----------
# Comma-separated. Bootstrap defaults to xovenmart.com + admin subdomain.
CORS_ORIGIN=https://xovenmart.com,https://www.xovenmart.com,https://admin.xovenmart.com

# ---------- API ----------
# Internal container port (don't change unless you also change docker-compose.yml).
PORT=3001
API_PREFIX=api/v1

# ---------- Uploads ----------
# Where the api container writes uploaded files. Mounted from the api_uploads
# named volume so images survive container restarts.
UPLOAD_DIR=/repo/apps/api/uploads
