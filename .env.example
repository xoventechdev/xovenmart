# ============================================================
# XovenMart — Environment Variables (development template)
# Copy to .env and fill in real values
# ============================================================

# ---------- Core ----------
NODE_ENV=development
PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001

# ---------- Database (Postgres) ----------
# Local dev: postgres://xovenmart:xovenmart@localhost:5432/xovenmart
DATABASE_URL=postgres://xovenmart:xovenmart@localhost:5432/xovenmart

# ---------- Auth ----------
# Generate: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-secret-min-48-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ---------- SMS (BulkSMSBD) ----------
# Sign up at https://www.bulksmsbd.com/
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=XovenMart
BULKSMSBD_BASE_URL=https://api.bulksmsbd.com/api/v1/send

# ---------- Payments ----------
# bKash Merchant Payment Link (manual reconciliation Day 1)
BKASH_MERCHANT_NUMBER=01XXXXXXXXX
BKASH_MERCHANT_NAME=XovenMart
# Nagad Merchant QR (printed on rider bag)
NAGAD_MERCHANT_NUMBER=01XXXXXXXXX

# ---------- Maps ----------
# OSM tile server (default free tile.openstreetmap.org)
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ---------- Image storage ----------
# Local dev: ./public/uploads
# Prod: Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=xovenmart-images
R2_PUBLIC_URL=https://cdn.xovenmart.com

# ---------- FCM (push notifications) ----------
# Get from Firebase Console → Project Settings → Service Accounts
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# ---------- Analytics (Umami) ----------
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
UMAMI_URL=http://localhost:3000

# ---------- Sentry (optional, error tracking) ----------
SENTRY_DSN=

# ---------- SMTP (admin-managed email providers) ----------
# 32-byte AES-256-GCM key for encrypting SMTP passwords at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SMTP_ENCRYPTION_KEY=

# SMTP — dev fallback (only used when no DB provider is configured AND NODE_ENV != production)
SMTP_DEV_HOST=
SMTP_DEV_PORT=587
SMTP_DEV_USER=
SMTP_DEV_PASS=
SMTP_DEV_FROM_ADDRESS=dev@xovenmart.local
SMTP_DEV_FROM_NAME=XovenMart Dev

# Backup notification recipients — comma-separated. Leave blank to disable.
# Used by BackupService.notifyBackupFinished() after every backup (success + failure).
BACKUP_NOTIFY_EMAILS=

# ---------- Backups ----------
BACKUP_DIR=/var/www/xovenmart/backups/postgres
BACKUP_WEBHOOK_TOKEN=replace-with-a-long-random-secret-for-the-bash-script-webhook

# ---------- n8n (chat automation) ----------
# See infra/ENV_N8N.md for the full operator runbook.

# Postgres DB password for the `n8n_user` role.
# MUST match the password in infra/postgres-init/02-create-n8n-db.sql.
# Generate: openssl rand -base64 24
N8N_DB_PASSWORD=replace-with-the-password-baked-into-02-create-n8n-db-sql

# 32-byte hex key used by n8n to encrypt stored credentials (page
# access tokens, the bot service token, etc.) at rest in xovenmart_n8n.
# LOSS OF THIS KEY = LOSS OF ALL N8N CREDENTIALS. Back it up to your
# password manager alongside JWT_SECRET.
# Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-with-64-hex-chars

# Basic-auth credentials for https://n8n.xovenmart.com.
# Generate the hashed password with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-plaintext-password'
# The plaintext is what you'll TYPE in the browser; the hash is what
# Caddy compares against. NEVER commit the plaintext.
N8N_ADMIN_USER=admin
N8N_ADMIN_PASSWORD_HASHED=$2a$14$replace-with-caddy-bcrypt-hash

# Bot service token — the long-lived JWT (aud=BOT) that n8n uses to call
# the API's bot/* endpoints. Generated by the API at boot, ALSO written
# to AppSetting.bot.serviceToken for rotation without redeploy.
# For first boot, generate manually:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_BOT_SERVICE_TOKEN=replace-with-64-hex-chars

# Shared secret between the API's webhook handlers (apps/api/.../bot/webhooks/*)
# and the n8n ingest webhook node. The API includes it as
# `X-Internal-Secret: ${N8N_INGEST_SECRET}` on every forwarded payload.
# Generate: openssl rand -hex 32
N8N_INGEST_SECRET=replace-with-64-hex-chars

# ---------- Messenger (Meta Platform) ----------
# Get from developers.facebook.com → App Settings → Basic.
META_APP_SECRET=
# Long-lived Page Access Token (Settings → Messenger → Connected Apps).
META_PAGE_ACCESS_TOKEN=
# Webhook verification token — any random string you choose; Meta echoes
# it back on the GET handshake.
META_VERIFY_TOKEN=replace-with-random-string

# ---------- WhatsApp Cloud (Meta) ----------
WHATSAPP_CLOUD_PHONE_ID=
WHATSAPP_CLOUD_TOKEN=

# ---------- WhatsApp Green API (unofficial, personal-number bridge) ----------
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
